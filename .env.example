APP_NAME=PPDA
DEBUG=true
# Use PostgreSQL 18 for the submission/demo. For local-only quick runs you can use
# SQLite instead: DATABASE_URL=sqlite:///./ppda.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ppda
JWT_SECRET=supersecretjwtkeyforppdadevelopmentonly1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 32-byte base64 key. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AES_MASTER_KEY=Zm9vYmFyYmF6cXV4MTIzNDU2Nzg5MGFiY2RlZmdoaWo=
FL_CLIENT_COUNT=5
FL_DP_DELTA=1e-5
FL_CLIP_NORM=1.0

# --- single-pipeline federated learning (Angular demo) ---
# Browser origins allowed to call the API (comma separated). The Angular dev
# server proxies /api to the backend, so this is only needed when the SPA is
# opened directly from another origin.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Loopback URL of the in-process coordinator. Supervised FL clients are spawned
# against it, which is why the FL demo needs no separate server process.
FL_SERVER_URL=http://127.0.0.1:8000
# How long POST /api/v1/federated/round waits for real clients to finish.
FL_ROUND_TIMEOUT_SECONDS=240
FL_LOCAL_EPOCHS=3
